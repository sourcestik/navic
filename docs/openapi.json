                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until another token is available"
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "source",
                  "destination"
                ],
                "properties": {
                  "source": {
                    "$ref": "#/components/schemas/Point"
                  },
                  "destination": {
                    "$ref": "#/components/schemas/Point"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "driving",
                      "walking",
                      "cycling"
                    ],
                    "default": "driving"
                  },
                  "algorithm": {
                    "type": "string",
                    "enum": [
                      "dijkstra",
                      "astar"
                    ],
                    "default": "astar"
                  }
                }
              },
              "example": {
                "source": {
                  "lat": 28.609,
                  "lon": 77.04
                },
                "destination": {
                  "lat": 28.602,
                  "lon": 77.025
                },
                "mode": "driving",
                "algorithm": "astar"
              }
            }
          }
        }
      }
