{
  "openapi": "3.0.3",
  "info": {
    "title": "Navic C++ Routing API",
    "version": "1.0.0",
    "description": "Shortest-distance routing within the Delhi pilot. Distances are meters, times seconds. Place search is a local OSM gazetteer. ETA has no live traffic. Data \u00a9 OpenStreetMap contributors, ODbL."
  },
  "servers": [
    {
      "url": "/",
      "description": "This API server"
    }
  ],
  "components": {
    "schemas": {
      "Point": {
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "Place": {
        "type": "object",
        "required": [
          "id",
          "name",
          "lat",
          "lon",
          "kind",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Route": {
        "type": "object",
        "required": [
          "geometry",
          "distance_m",
          "duration_s",
          "steps",
          "snapped",
          "algorithm",
          "mode",
          "cached",
          "visited_nodes",
          "search_ms",
          "data_version",
          "warnings"
        ],
        "properties": {
          "geometry": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "LineString"
                ]
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[longitude, latitude]"
                },
                "minItems": 2
              }
            }
          },
          "distance_m": {
            "type": "number",
            "minimum": 0
          },
          "duration_s": {
            "type": "number",
            "minimum": 0
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "maneuver",
                "instruction",
                "road",
                "distance_m",
                "duration_s",
                "coordinate"
              ],
              "properties": {
                "maneuver": {
                  "type": "string",
                  "enum": [
                    "depart",
                    "continue",
                    "left",
                    "right",
                    "uturn",
                    "arrive"
                  ]
                },
                "instruction": {
                  "type": "string"
                },
                "road": {
                  "type": "string"
                },
                "distance_m": {
                  "type": "number"
                },
                "duration_s": {
                  "type": "number"
                },
                "coordinate": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[longitude, latitude]"
                }
              }
            }
          },
          "snapped": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "required": [
                  "lat",
                  "lon",
                  "osm_id",
                  "distance_m"
                ],
                "properties": {
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lon": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "osm_id": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "distance_m": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "destination": {
                "type": "object",
                "required": [
                  "lat",
                  "lon",
                  "osm_id",
                  "distance_m"
                ],
                "properties": {
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lon": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "osm_id": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "distance_m": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "driving",
              "walking",
              "cycling"
            ]
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "astar",
              "dijkstra"
            ]
          },
          "cached": {
            "type": "boolean"
          },
          "visited_nodes": {
            "type": "integer"
          },
          "search_ms": {
            "type": "number"
          },
          "data_version": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Graph readiness and counts",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "nodes",
                    "edges"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "service": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "nodes": {
                      "type": "integer"
                    },
                    "edges": {
                      "type": "integer"
                    },
                    "places": {
                      "type": "integer"
                    },
                    "uptime_s": {
                      "type": "number"
                    },
                    "data_version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON or query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No route or endpoint not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported content type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid values or outside coverage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until another token is available"
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/coverage": {
      "get": {
        "summary": "Coverage and data provenance",
        "responses": {
          "200": {
            "description": "Successful response",
