              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "bbox",
                    "modes",
                    "algorithms"
                  ],
                  "properties": {
                    "bbox": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "number"
                      },
                      "description": "south, west, north, east"
                    },
                    "name": {
                      "type": "string"
                    },
                    "modes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "algorithms": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "max_snap_m": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON or query",
